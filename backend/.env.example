PORT=5000
# Cloud Database (Supabase or Neon PostgreSQL)
DATABASE_URL=
# Kafka broker URL (Default localhost:9092 from Docker Compose)
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=order-stream-service
KAFKA_GROUP_ID=order-processing-group
# RabbitMQ AMQP URL (Default localhost:5672 from Docker Compose)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
